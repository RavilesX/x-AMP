# Kept out of the release tarball that `git archive` produces. None of it is
# needed to build x-AMP: the artwork masters are sources for the images that
# are already committed in their final form, and the rest is CI plumbing that
# only means anything inside this repository.
/artwork export-ignore
/.github export-ignore
/ci export-ignore
/.claude export-ignore
/.gitattributes export-ignore
