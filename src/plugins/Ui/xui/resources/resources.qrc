<!--
  The equalizer presets a fresh profile starts with: the Winamp set upstream
  ships for the skinned interface. Referenced rather than copied, so the two
  interfaces cannot drift apart over what "Rock" means, and it is the same
  10-band format xui reads for the user's own file.
-->
<RCC>
    <qresource prefix="/xui">
        <file alias="eq.preset">../../skinned/resources/eq.preset</file>
    </qresource>
</RCC>
