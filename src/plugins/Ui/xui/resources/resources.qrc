<!--
  The equalizer presets a fresh profile starts with: the Winamp set upstream
  shipped with the skinned interface. It used to be referenced across from
  there so the two could not drift over what "Rock" means; with that interface
  gone the file lives here, in the same 10-band format xui reads for the
  user's own presets.
-->
<RCC>
    <qresource prefix="/xui">
        <file>eq.preset</file>
    </qresource>
</RCC>
